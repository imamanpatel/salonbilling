# Copy to apps/api/.env and fill in.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sabilling?schema=public"

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
PORT=4000
SESSION_HOURS=12
# Time zone used for "today" (follow-ups, birthdays, daily reports)
BUSINESS_TIMEZONE="Asia/Kolkata"

# Used once by `npm run db:seed` to create the organisation, first branch and superadmin.
SEED_ORG_NAME="My Salon"
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_PASSWORD=""

# Optional: integration tests. Database name MUST end in _test (it gets wiped).
# Put this in apps/api/.env.test
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sabilling_test?schema=public"
